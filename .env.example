# NEVER commit a real .env (C-01, NFR-SEC-01)
GSB_API_KEY=
VT_API_KEY=
PHISHTANK_API_KEY=
URLSCAN_API_KEY=
APP_TOKEN=change-me
# Separate from APP_TOKEN. Required for /admin report review. Leave empty to disable admin.
ADMIN_TOKEN=change-me-admin
DATABASE_URL=sqlite+aiosqlite:///./safelink.db
# DATABASE_URL=postgresql+asyncpg://safelink:safelink@db:5432/safelink
REDIS_URL=
# Raw 32-byte Ed25519 private key, base64. When set, version 1 of the rule package is seeded.
# python -c "import base64,os; print(base64.b64encode(os.urandom(32)).decode())"
RULES_SIGNING_KEY_B64=
INTERNAL_DEADLINE_S=1.5
